    {
      "page_index": 8,
      "text": "* On Viola V1.0 and V1.1, ETH_TX0_P/N signals are swapped with respect to Colibri standard pin-out.",
      "bbox": [
        85.10399627685547,
        731.2661743164062,
        540.848876953125,
        742.37158203125
      ],
      "origin": [
        85.10399627685547,
        740.2799682617188
      ],
      "size": 9.960000038146973,
      "font": "Arial",
      "flags": 0,
      "color": 0
    },
    {
      "page_index": 8,
